{
  "name": "acquiro-scraper",
  "version": "1.0.0",
  "description": "Stealth web scraper for UK business listing sites",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "postinstall": "npx playwright install chromium --with-deps",
