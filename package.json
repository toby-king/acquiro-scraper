  },
  "dependencies": {
    "@pinecone-database/pinecone": "^7.1.0",
    "cheerio": "^1.2.0",
    "node-cron": "^4.2.1",
    "openai": "^6.25.0",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "user-agents": "^1.1.669"
